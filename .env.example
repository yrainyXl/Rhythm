# Environment Variables Template
# 复制为 .env 并填入实际值(运行时由 docker compose 的 env_file 注入)。

# TencentDB PostgreSQL（必填）
TENCENTDB_HOST=your-db-host
TENCENTDB_PORT=5432
TENCENTDB_DATABASE=rhythm
TENCENTDB_USER=rhythm
TENCENTDB_PASSWORD=your-db-password
TENCENTDB_SSL=true
# TENCENTDB_CA=/path/to/tencentdb-ca.pem   # 证书校验开启时腾讯云 CA 文件；留空用系统 CA

# 会话鉴权
SESSION_TTL_DAYS=30            # 空闲过期天数（滑动续期作用于它）
SESSION_ABSOLUTE_TTL_DAYS=90   # 会话硬上限天数（cookie 寿命与之对齐）
AUTH_COOKIE_SECURE=true        # nginx TLS 时为 true；纯内网 HTTP 时必须设 false

# 微信读书同步（可选，服务端使用，勿加 NEXT_PUBLIC_ 前缀）
WEREAD_API_KEY=your-weread-api-key
